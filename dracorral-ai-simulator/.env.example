# Dra. Corral AI Simulator — Environment Variables
# Copy this file to .env.local and fill in your values

# ── Google Gemini API (required for AI image generation) ──────────────────
# Get your key at: https://aistudio.google.com/app/apikey
# POC: key is used directly from the browser.
# Production: move this call to a Firebase Cloud Function for security.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ── WhatsApp booking CTA ──────────────────────────────────────────────────
# Chilean mobile number, digits only (no + or spaces)
# Example: 56912345678  →  https://wa.me/56912345678
VITE_WA_PHONE=56912345678
