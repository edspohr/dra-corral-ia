# ============================================================
# Dra. Corral AI Beauty Simulator — Environment Variables
# Copy this file to .env.local and fill in all values
# NEVER commit .env.local to version control
# ============================================================

# --- REQUIRED: Google AI (Nano Banana Pro / Gemini) ---
# Get at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_google_ai_key_here

# --- REQUIRED: Firebase Project ---
# Get from Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# --- REQUIRED: Business ---
# WhatsApp number for booking CTA (Chilean format, digits only, no +)
VITE_WA_PHONE=56912345678

# --- OPTIONAL: For production (Phase 6) ---
# Base URL of deployed Firebase Cloud Functions
# Leave empty for POC (direct Gemini calls from browser)
VITE_FUNCTIONS_BASE_URL=
