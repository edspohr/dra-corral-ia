# ============================================================
# Dra. Corral AI Beauty Simulator — Environment Variables
# Copy this file to .env.local and fill in all values
# NEVER commit .env.local to version control
# ============================================================

# --- REQUIRED: Google AI (Gemini image generation) ---
# Get at: https://aistudio.google.com/app/apikey
# Used for: direct browser → Gemini API calls (POC architecture)
VITE_GEMINI_API_KEY=your_google_ai_key_here

# --- OPTIONAL: Firebase (future use — not active in POC) ---
# Get from Firebase Console → Project Settings → Your apps → Web app
# Currently only firebase.ts initialises the app; Firestore and Storage
# are not called from any active flow. Leave blank if not needed.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
